<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.endroid.screenoff">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Screen Off"
        android:theme="@style/Theme.ScreenOff">

        <!-- Launcher activity (transparent, locks instantly) -->
        <activity
            android:name=".LockActivity"
            android:exported="true"
            android:theme="@style/Theme.ScreenOff.Transparent"
            android:excludeFromRecents="true"
            android:noHistory="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Setup activity (first-time setup) -->
        <activity
            android:name=".SetupActivity"
            android:exported="false"
            android:theme="@style/Theme.ScreenOff" />

        <!-- Accessibility Service (locks the screen) -->
        <service
            android:name=".LockAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Quick Settings Tile Service (NO external XML needed!) -->
        <service
            android:name=".LockTileService"
            android:icon="@drawable/quick_tile"
            android:label="Screen Off"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

    </application>
</manifest>